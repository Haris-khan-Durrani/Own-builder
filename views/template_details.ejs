<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Template Editor · <%= template.template_title %></title>
    <!-- GrapesJS and Plugins -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/grapesjs/0.22.2/grapes.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/grapesjs/0.22.2/css/grapes.min.css">
    <script src="https://unpkg.com/grapesjs-preset-newsletter@1.0.1"></script>
    <!-- Bootstrap for UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font Awesome (for icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<script src="https://unpkg.com/grapesjs-signature-pad"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.1/jquery.min.js" integrity="sha512-aVKKRRi/Q/YV+4mjoKBsE4x3H+BkegoM/em46NNlCqNTmUYADjBbeNefNxYV7giUp0VxICtqdrbqU7iVaeZNXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/grapesjs-preset-webpage@1.0.2"></script>
    <script src="https://unpkg.com/grapesjs-blocks-basic@1.0.1"></script>
    <script src="https://unpkg.com/grapesjs-plugin-forms@2.0.5"></script>
    <script src="https://unpkg.com/grapesjs-component-countdown@1.0.1"></script>
    <script src="https://unpkg.com/grapesjs-plugin-export@1.0.11"></script>
    <script src="https://unpkg.com/grapesjs-tabs@1.0.6"></script>
    <script src="https://unpkg.com/grapesjs-custom-code@1.0.1"></script>
    <script src="https://unpkg.com/grapesjs-touch@0.1.1"></script>
    <script src="https://unpkg.com/grapesjs-parser-postcss@1.0.1"></script>
    <script src="https://unpkg.com/grapesjs-tooltip@0.1.7"></script>
    <script src="https://unpkg.com/grapesjs-tui-image-editor@0.1.3"></script>
    <script src="https://unpkg.com/grapesjs-typed@1.0.5"></script>
    <script src="https://unpkg.com/grapesjs-style-bg@1.0.5"></script>
    <link href="https://unpkg.com/grapesjs-component-code-editor/dist/grapesjs-component-code-editor.min.css" rel="stylesheet">
    <script src="https://unpkg.com/grapesjs-component-code-editor"></script>


    <script src="https://cdn.jsdelivr.net/npm/grapesjs-plugin-ckeditor@0.0.10/dist/grapesjs-plugin-ckeditor.min.js"></script>
    <script src="https://cdn.ckeditor.com/4.16.1/full-all/ckeditor.js"></script>
    
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.0/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.0/dist/sweetalert2.all.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --topbar-h: 56px;
        --brand: #0284c7;
        --brand-dark: #0369a1;
        --success: #22c55e;
        --warning: #f59e0b;
        --surface: #1e2433;
        --surface-2: #252d40;
        --surface-3: #2e3a54;
        --border: rgba(255,255,255,0.08);
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --radius: 8px;
        --shadow: 0 4px 24px rgba(0,0,0,.35);
      }
      html, body { height: 100%; margin: 0; padding: 0; font-family: 'Inter', system-ui, sans-serif; background: #0f172a; overflow: hidden; }

      /* TOP BAR */
      #editor-topbar {
        position: fixed; top: 0; left: 0; right: 0;
        height: var(--topbar-h);
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; gap: 10px;
        padding: 0 16px; z-index: 9999;
        box-shadow: 0 2px 12px rgba(0,0,0,.4);
      }
      #editor-topbar .brand { display: flex; align-items: center; gap: 8px; color: var(--text); font-weight: 700; font-size: 14px; white-space: nowrap; margin-right: 4px; }
      #editor-topbar .brand .logo-dot { width: 28px; height: 28px; background: var(--brand); border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,.5); }
      .topbar-sep { width: 1px; height: 26px; background: var(--border); flex-shrink: 0; margin: 0 2px; }
      .topbar-spacer { flex: 1; }
      #titl { background: var(--surface-3); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius); padding: 6px 12px; font-size: 13px; font-family: 'Inter', sans-serif; width: 200px; outline: none; transition: border-color .2s, box-shadow .2s; }
      #titl:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(37,99,235,.22); }
      #domainDropdown { background: var(--surface-3); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius); padding: 6px 10px; font-size: 13px; font-family: 'Inter', sans-serif; width: 160px; outline: none; cursor: pointer; }
      .tb-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: var(--radius); font-size: 13px; font-weight: 500; font-family: 'Inter', sans-serif; border: none; cursor: pointer; text-decoration: none; transition: all .15s; white-space: nowrap; }
      .tb-btn:active { transform: scale(.97); }
      .tb-btn-save { background: var(--brand); color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,.4); }
      .tb-btn-save:hover { background: var(--brand-dark); color: #fff; }
      .tb-btn-ghost { background: var(--surface-3); color: var(--text-muted); border: 1px solid var(--border); }
      .tb-btn-ghost:hover { background: var(--surface-2); color: var(--text); }
      .tb-btn-branding { background: linear-gradient(135deg,#7c3aed,#4f46e5); color: #fff; }
      .tb-btn-branding:hover { opacity: .88; color: #fff; }
      #save-status { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 5px; white-space: nowrap; }
      #save-status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); display: inline-block; }
      #save-status .dot.saving { background: var(--warning); animation: blink 1s infinite; }
      @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

      /* CANVAS */
      #editor-canvas-wrap { position: fixed; top: var(--topbar-h); left: 0; right: 0; bottom: 0; overflow: hidden; }
      .gjs-editor-cont, .gjs-editor { height: 100% !important; }

      /* GRAPESJS THEME */
      .gjs-pn-panel.gjs-pn-views-container,
      .gjs-pn-panel.gjs-pn-views,
      .gjs-pn-panel.gjs-pn-options,
      .gjs-pn-panel.gjs-pn-commands { background: var(--surface) !important; border-color: var(--border) !important; }
      .gjs-block { background: var(--surface-3) !important; border: 1px solid var(--border) !important; border-radius: 8px !important; color: var(--text) !important; transition: background .15s, border-color .15s, transform .1s; margin: 4px !important; }
      .gjs-block:hover { background: var(--surface-2) !important; border-color: var(--brand) !important; transform: translateY(-1px); }
      .gjs-block__media { color: var(--brand) !important; fill: var(--brand) !important; }
      .gjs-block__label { color: var(--text-muted) !important; font-size: 11px !important; }
      .gjs-block-category .gjs-title, .gjs-sm-sector-title, .gjs-sm-sector .gjs-sm-title { background: var(--surface-2) !important; color: var(--text) !important; border-bottom: 1px solid var(--border) !important; font-size: 10px !important; font-weight: 700 !important; letter-spacing: .06em !important; text-transform: uppercase !important; padding: 8px 12px !important; }
      .gjs-pn-btn { color: var(--text-muted) !important; border-radius: 6px !important; transition: all .15s !important; margin: 2px !important; }
      .gjs-pn-btn:hover, .gjs-pn-btn.gjs-pn-active { background: var(--brand) !important; color: #fff !important; }
      .gjs-sm-field input, .gjs-sm-field select, .gjs-trt-trait input, .gjs-trt-trait select, .gjs-field input { background: var(--surface-3) !important; border: 1px solid var(--border) !important; color: var(--text) !important; border-radius: 5px !important; font-family: 'Inter', sans-serif !important; font-size: 12px !important; }
      .gjs-sm-field input:focus, .gjs-trt-trait input:focus { border-color: var(--brand) !important; outline: none !important; }
      .gjs-sm-label, .gjs-trt-trait__label, .gjs-clm-label, .gjs-layer-name { color: var(--text) !important; font-size: 12px !important; }
      .gjs-layer { background: var(--surface-2) !important; border-bottom: 1px solid var(--border) !important; }
      .gjs-layer.gjs-selected { background: var(--surface-3) !important; }
      .gjs-toolbar { background: var(--surface) !important; border-radius: 8px !important; border: 1px solid var(--border) !important; box-shadow: var(--shadow) !important; padding: 3px !important; }
      .gjs-toolbar-item { border-radius: 5px !important; color: var(--text-muted) !important; transition: background .15s !important; }
      .gjs-toolbar-item:hover { background: var(--brand) !important; color: #fff !important; }
      .gjs-cv-canvas { background: #0f172a !important; }
      .gjs-selected { outline: 1.5px solid #38bdf8 !important; outline-offset: 1px; }
      .gjs-highlighter, .gjs-highlighter-c { outline: 1px dashed #38bdf8 !important; }
      .gjs-badge, .gjs-badge__name { background-color: #0f172a !important; color: #38bdf8 !important; font-size: 10px !important; border-radius: 4px !important; border: 1px solid rgba(56,189,248,0.3) !important; }
      .gjs-mdl-dialog { background: var(--surface) !important; border: 1px solid var(--border) !important; border-radius: 12px !important; box-shadow: var(--shadow) !important; }
      .gjs-mdl-header { background: var(--surface-2) !important; border-bottom: 1px solid var(--border) !important; }
      .gjs-mdl-title { color: var(--text) !important; font-family: 'Inter', sans-serif !important; }
      .gjs-mdl-btn-close { color: var(--text-muted) !important; }
      .gjs-am-assets-header { background: var(--surface-2) !important; border-bottom: 1px solid var(--border) !important; }
      .gjs-am-asset { background: var(--surface-3) !important; border: 1px solid var(--border) !important; border-radius: 6px !important; }
      .gjs-am-asset:hover { border-color: var(--brand) !important; }

      /* SHORTCUT HINT */
      #shortcut-hint { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); background: var(--surface); border: 1px solid var(--border); border-radius: 99px; padding: 5px 16px; font-size: 11px; color: var(--text-muted); display: flex; gap: 16px; z-index: 8000; box-shadow: var(--shadow); pointer-events: none; opacity: .8; }
      #shortcut-hint kbd { background: var(--surface-3); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; font-size: 10px; color: var(--text); font-family: monospace; }

      /* ── A4 CANVAS LAYOUT ── */
      /* Dark workspace background with padding around the page and centered page alignment */
      .gjs-cv-canvas {
        background: #0f172a !important;
        padding: 40px 20px !important;
        box-sizing: border-box !important;
        display: flex !important;
        justify-content: center !important;
        align-items: flex-start !important;
        overflow: auto !important;
      }

      /* Frame wrapper — strict A4 portrait dimensions & paper elevation shadow */
      .gjs-frame-wrapper {
        width: 794px !important;             /* Exact A4 width at 96 DPI (210mm) */
        min-height: 1123px !important;       /* Exact A4 height at 96 DPI (297mm) */
        margin: 0 auto !important;
        border-radius: 4px !important;
        box-shadow: 0 14px 45px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08) !important;
        background: #ffffff !important;
        outline: none !important;
        overflow: visible !important;
        transition: width 0.25s ease, min-height 0.25s ease;
      }

      /* Frame itself inside wrapper */
      .gjs-frame {
        width: 794px !important;
        border: none !important;
        display: block !important;
        margin: 0 auto !important;
        background: #ffffff !important;
      }

      /* ZOOM & PAGE MODE CONTROL BAR */
      #canvas-zoom-bar {
        position: fixed;
        bottom: 32px;
        right: 24px;
        z-index: 8500;
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(15, 23, 42, 0.92);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 99px;
        padding: 6px 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        font-size: 12px;
        color: #94a3b8;
      }
      #canvas-zoom-bar button {
        background: #1e293b;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f8fafc;
        border-radius: 6px;
        height: 28px;
        padding: 0 9px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 12px; font-weight: 500;
        transition: all .15s ease;
      }
      #canvas-zoom-bar button:hover { background: #2563eb; color: #fff; border-color: #3b82f6; }
      #canvas-zoom-bar button.active-orient { background: #2563eb; color: #fff; border-color: #3b82f6; font-weight: 600; }
      #zoom-value { min-width: 42px; text-align: center; font-weight: 600; color: #f8fafc; font-size: 12px; }

      /* ── TABLE THEME DROPDOWN ── */
      #tableThemeDropdown {
        background: var(--surface-3);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: var(--radius);
        padding: 6px 10px;
        font-size: 12px;
        font-family: 'Inter', sans-serif;
        width: 152px;
        outline: none;
        cursor: pointer;
      }
      #tableThemeDropdown:focus { border-color: var(--brand); }

      /* ═══════════════════════════════════════════════════════════
         SMART STYLE PANEL – Right-side element style editor
      ═══════════════════════════════════════════════════════════ */
      #ssp-panel {
        position: fixed;
        top: var(--topbar-h);
        right: -360px;
        width: 340px;
        bottom: 0;
        background: #131c2e;
        border-left: 1px solid rgba(255,255,255,0.09);
        z-index: 9500;
        display: flex;
        flex-direction: column;
        transition: right 0.28s cubic-bezier(0.4,0,0.2,1);
        box-shadow: -6px 0 32px rgba(0,0,0,0.5);
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #e2e8f0;
        overflow: hidden;
      }
      #ssp-panel.ssp-open { right: 0; }

      /* Panel header */
      #ssp-header {
        background: #1e2a40;
        padding: 10px 12px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        flex-shrink: 0;
      }
      #ssp-breadcrumb {
        display: flex; align-items: center; gap: 6px;
        font-size: 11px; color: #94a3b8; margin-bottom: 6px;
      }
      #ssp-breadcrumb .ssp-tag {
        background: rgba(56,189,248,0.12); color: #38bdf8;
        border: 1px solid rgba(56,189,248,0.3); border-radius: 4px;
        padding: 1px 7px; font-weight: 700; font-size: 11px; font-family: monospace;
      }
      #ssp-breadcrumb .ssp-cls {
        background: rgba(168,85,247,0.12); color: #a855f7;
        border: 1px solid rgba(168,85,247,0.3); border-radius: 4px;
        padding: 1px 7px; font-weight: 600; font-size: 10px; font-family: monospace;
        max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      #ssp-header-actions {
        display: flex; gap: 6px; align-items: center;
      }
      .ssp-hbtn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 4px 9px; border-radius: 5px; font-size: 10px; font-weight: 600;
        cursor: pointer; border: 1px solid rgba(255,255,255,0.12);
        background: #2e3a54; color: #94a3b8;
        transition: all 0.15s;
      }
      .ssp-hbtn:hover { background: #3b4a68; color: #f1f5f9; }
      .ssp-hbtn.active { background: #2563eb; color: #fff; border-color: #2563eb; }
      .ssp-hbtn.danger { background: #450a0a; color: #f87171; border-color: #7f1d1d; }
      .ssp-hbtn.danger:hover { background: #7f1d1d; color: #fff; }

      /* Tabs */
      #ssp-tabs {
        display: flex; flex-wrap: wrap; gap: 2px;
        padding: 6px 8px; background: #1a2437;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        flex-shrink: 0;
      }
      .ssp-tab {
        padding: 4px 8px; border-radius: 5px; font-size: 10px; font-weight: 600;
        cursor: pointer; color: #64748b; background: transparent;
        border: 1px solid transparent; transition: all 0.15s; white-space: nowrap;
      }
      .ssp-tab:hover { color: #94a3b8; background: rgba(255,255,255,0.04); }
      .ssp-tab.ssp-tab-active {
        background: #0f172a; color: #38bdf8;
        border-color: rgba(56,189,248,0.3);
      }

      /* Content area */
      #ssp-body {
        flex: 1; overflow-y: auto; padding: 10px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.1) transparent;
      }
      #ssp-body::-webkit-scrollbar { width: 4px; }
      #ssp-body::-webkit-scrollbar-track { background: transparent; }
      #ssp-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 2px; }

      /* Tab panes */
      .ssp-pane { display: none; }
      .ssp-pane.ssp-pane-active { display: block; }

      /* Section headers */
      .ssp-section {
        margin-bottom: 12px;
      }
      .ssp-section-head {
        display: flex; align-items: center; justify-content: space-between;
        font-size: 9px; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.08em; color: #475569; margin-bottom: 8px;
        padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,0.05);
      }

      /* Row */
      .ssp-row {
        display: flex; align-items: center; gap: 6px;
        margin-bottom: 7px;
      }
      .ssp-label {
        width: 88px; flex-shrink: 0;
        color: #64748b; font-size: 10px; font-weight: 600;
      }
      .ssp-control { flex: 1; display: flex; align-items: center; gap: 4px; }

      /* Input types */
      .ssp-input {
        width: 100%; padding: 4px 8px; border-radius: 4px;
        background: #0f172a; border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0; font-size: 11px; font-family: 'Inter', sans-serif;
        outline: none; transition: border-color 0.15s;
      }
      .ssp-input:focus { border-color: #38bdf8; }
      .ssp-input-sm { width: 56px; text-align: center; }
      .ssp-select {
        flex: 1; padding: 4px 6px; border-radius: 4px;
        background: #0f172a; border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0; font-size: 11px; font-family: 'Inter', sans-serif;
        outline: none; cursor: pointer;
      }
      .ssp-select:focus { border-color: #38bdf8; }

      /* Color row */
      .ssp-color-wrap {
        display: flex; align-items: center; gap: 6px; flex: 1;
      }
      .ssp-color-swatch {
        width: 28px; height: 28px; border-radius: 6px;
        border: 2px solid rgba(255,255,255,0.15);
        cursor: pointer; flex-shrink: 0; overflow: hidden; padding: 0;
      }
      .ssp-color-swatch input[type=color] {
        width: 40px; height: 40px;
        border: none; padding: 0; margin: -4px;
        background: none; cursor: pointer;
      }

      /* Slider row */
      .ssp-slider-wrap { flex: 1; display: flex; align-items: center; gap: 5px; }
      .ssp-range {
        flex: 1; height: 4px; accent-color: #38bdf8;
      }

      /* Unit toggle */
      .ssp-unit {
        display: flex; gap: 2px;
      }
      .ssp-unit-btn {
        padding: 2px 5px; font-size: 9px; border-radius: 3px; cursor: pointer;
        background: #1e2a40; color: #64748b; border: 1px solid transparent;
        transition: all 0.1s;
      }
      .ssp-unit-btn.active { background: #2563eb; color: #fff; }

      /* Quad input (top/right/bottom/left) */
      .ssp-quad {
        display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 4px; flex: 1;
      }
      .ssp-quad-wrap {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
      }
      .ssp-quad-label { font-size: 8px; color: #475569; font-weight: 600; }
      .ssp-quad-input {
        width: 100%; padding: 3px 4px; text-align: center;
        border-radius: 4px; background: #0f172a;
        border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0;
        font-size: 11px; font-family: 'Inter', sans-serif; outline: none;
      }
      .ssp-quad-input:focus { border-color: #38bdf8; }

      /* Button group (e.g. text-align, display) */
      .ssp-btngroup {
        display: flex; gap: 3px; flex: 1; flex-wrap: wrap;
      }
      .ssp-bgbtn {
        flex: 1; padding: 4px 4px; text-align: center;
        border-radius: 4px; font-size: 10px; font-weight: 600;
        background: #1e2a40; color: #64748b;
        border: 1px solid rgba(255,255,255,0.07); cursor: pointer;
        transition: all 0.12s; min-width: 28px;
      }
      .ssp-bgbtn:hover { background: #2e3a54; color: #94a3b8; }
      .ssp-bgbtn.active { background: #2563eb; color: #fff; border-color: #2563eb; }

      /* CSS preview */
      #ssp-css-preview-wrap {
        padding: 8px 10px;
        background: #0d1525;
        border-top: 1px solid rgba(255,255,255,0.07);
        flex-shrink: 0;
      }
      #ssp-css-preview-label {
        font-size: 9px; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.08em; color: #475569; margin-bottom: 4px;
      }
      #ssp-css-preview {
        width: 100%; height: 48px; resize: none;
        background: #0a0f1a; border: 1px solid rgba(255,255,255,0.07);
        color: #4ade80; font-size: 9px; font-family: monospace;
        border-radius: 4px; padding: 5px 8px; outline: none;
      }

      /* Divider */
      .ssp-divider {
        height: 1px; background: rgba(255,255,255,0.05);
        margin: 10px 0;
      }

      /* Textarea for content editing */
      .ssp-textarea {
        width: 100%; min-height: 80px; resize: vertical;
        padding: 6px 8px; border-radius: 4px;
        background: #0f172a; border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0; font-size: 11px; font-family: 'Inter', sans-serif;
        outline: none; transition: border-color 0.15s;
      }
      .ssp-textarea:focus { border-color: #38bdf8; }

      /* Scroll the canvas area left of panel when panel is open */
      #editor-canvas-wrap { transition: right 0.28s cubic-bezier(0.4,0,0.2,1); }
      body.ssp-open #editor-canvas-wrap { right: 340px; }
    </style>
  </head>
  <body>
    <!-- MODERN TOP BAR -->
    <div id="editor-topbar">
      <div class="brand">
        <div class="logo-dot"><i class="fa fa-pencil"></i></div>
        <span>Template Editor</span>
      </div>
      <div class="topbar-sep"></div>
      <label style="color:var(--text-muted);font-size:12px;margin:0;white-space:nowrap;">Title</label>
      <input type="text" id="titl" value="<%= template.template_title %>" placeholder="Template title...">
      <div class="topbar-sep"></div>
      <label style="color:var(--text-muted);font-size:12px;margin:0;white-space:nowrap;">Domain</label>
      <select id="domainDropdown">
        <option hidden value="">Select Domain</option>
      </select>
      <div class="topbar-sep"></div>
      <label style="color:var(--text-muted);font-size:12px;margin:0;white-space:nowrap;">🗂 Table Style</label>
      <select id="tableThemeDropdown" onchange="applyTableThemeToCanvas(this.value)">
        <option value="domain">↳ Domain Default</option>
        <option value="navy-corporate">Navy Corporate</option>
        <option value="emerald-clean">Emerald Clean</option>
        <option value="gold-premium">Gold Premium</option>
        <option value="minimal-lines">Minimal Lines</option>
        <option value="rose-soft">Rose Soft</option>
      </select>
      <div class="topbar-spacer"></div>
      <div id="save-status"><span class="dot" id="save-dot"></span><span id="save-label">All changes saved</span></div>
      <div class="topbar-sep"></div>
      <button onclick="openVariablePickerModal()" class="tb-btn tb-btn-branding" id="btn-var-picker">
        <i class="fa fa-bolt"></i> ⚡ Insert Variable
      </button>
      <button onclick="syncGlobalBlocks()" class="tb-btn tb-btn-ghost" id="btn-sync-blocks" title="Sync latest shared blocks">
        <i class="fa fa-refresh"></i> Sync Blocks
      </button>
      <button onclick="toggleLivePreview()" class="tb-btn tb-btn-ghost" id="btn-toggle-preview">
        <i class="fa fa-eye"></i> Live Client Preview
      </button>
      <button onclick="openQuickGlobalBrandingModal()" class="tb-btn tb-btn-branding">
        <i class="fa fa-paint-brush"></i> Global Branding
      </button>
      <button onclick="convertToModernDesign()" class="tb-btn" style="background: linear-gradient(135deg, #0284c7, #06b6d4); color: #fff; border: none; font-weight: 600; box-shadow: 0 2px 6px rgba(2, 132, 199, 0.4);" title="Convert active template layout to Modern 360 Business Proposal design (Image 2)">
        <i class="fa fa-magic"></i> ✨ Convert to Modern Design
      </button>
      <a href="/edit-template?tmpid=<%= template.template_id %>&domain_id=<%= domain_id %>&token=<%= token %>" class="tb-btn tb-btn-ghost">
        <i class="fa fa-code"></i> HTML / CSS
      </a>
      <button onclick="saveTemplate()" class="tb-btn tb-btn-save" id="save-btn">
        <i class="fa fa-floppy-o"></i> Save Template
      </button>
    </div>

    <!-- KEYBOARD SHORTCUT HINT -->
    <div id="shortcut-hint">
      <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> Undo</span>
      <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> Redo</span>
      <span><kbd>Del</kbd> Delete</span>
      <span><kbd>Esc</kbd> Deselect</span>
    </div>

    <!-- USER-FRIENDLY FLOATING VARIABLE PICKER MODAL -->
    <div id="varPickerModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.75); z-index:99999; backdrop-filter:blur(4px); align-items:center; justify-content:center;">
      <div style="background:#1e2433; border:1px solid rgba(255,255,255,0.15); border-radius:12px; width:650px; max-width:92vw; box-shadow:0 20px 40px rgba(0,0,0,0.5); color:#f1f5f9; overflow:hidden;">
        <div style="padding:16px 20px; background:#252d40; border-bottom:1px solid rgba(255,255,255,0.1); display:flex; justify-content:space-between; align-items:center;">
          <h3 style="margin:0; font-size:16px; font-weight:700; color:#fff; display:flex; align-items:center; gap:8px;">
            <i class="fa fa-bolt" style="color:#f59e0b;"></i> ⚡ Insert Dynamic Variable
          </h3>
          <button onclick="closeVariablePickerModal()" style="background:none; border:none; color:#94a3b8; font-size:18px; cursor:pointer;"><i class="fa fa-times"></i></button>
        </div>
        <div style="padding:20px; max-height:70vh; overflow-y:auto;">
          <p style="margin:0 0 16px 0; font-size:13px; color:#94a3b8;">Click any variable chip below to insert it into your currently selected template text. <strong>No manual shortcode typing required!</strong></p>
          
          <!-- Category 1: Client Details -->
          <div style="margin-bottom:16px;">
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#38bdf8;"><i class="fa fa-user"></i> 👤 Client Details</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[cname]')">Client Name <code>[cname]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[cemail]')">Client Email <code>[cemail]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[companyname]')">Company Name <code>[companyname]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[cphone]')">Phone Number <code>[cphone]</code></button>
            </div>
          </div>

          <!-- Category 2: Pricing & Fees -->
          <div style="margin-bottom:16px;">
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#4ade80;"><i class="fa fa-money"></i> 💰 Pricing & Fees</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[price]')">License Price <code>[price]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[renewal_amount]')">Renewal Amount <code>[renewal_amount]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[AddMoreAmount]')">Pro & Service Fee <code>[AddMoreAmount]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[1st_year_price1]')">1st Year Price <code>[1st_year_price1]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[2nd_year_price2]')">2nd Year Price <code>[2nd_year_price2]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[currency]')">Currency Symbol <code>[currency]</code></button>
            </div>
          </div>

          <!-- Category 3: Bank & Payment Info -->
          <div style="margin-bottom:16px;">
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#facc15;"><i class="fa fa-university"></i> 🏦 Bank Details</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[Banktile]')">Account Title <code>[Banktile]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[Accountnumber]')">Account Number <code>[Accountnumber]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[Ibannumber]')">IBAN Number <code>[Ibannumber]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[bank]')">Bank Name <code>[bank]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[branch]')">Branch <code>[branch]</code></button>
            </div>
          </div>

          <!-- Category 4: Dates & Meta -->
          <div>
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#a78bfa;"><i class="fa fa-calendar"></i> 📅 Proposal Meta</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[pdte]')">Valid Day <code>[pdte]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[pmonth]')">Valid Month <code>[pmonth]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[pyear]')">Valid Year <code>[pyear]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[submission_id]')">Verification Code <code>[submission_id]</code></button>
            </div>
          </div>

          <!-- Category 5: Master Backgrounds & Custom Labeled Images -->
          <div style="margin-top:16px;">
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#ec4899;"><i class="fa fa-picture-o"></i> 🖼️ Master Images & Custom Badges</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[cover_bg_image]')">Cover Background <code>[cover_bg_image]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[inner_bg_image]')">Inner Page Background <code>[inner_bg_image]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[closing_bg_image]')">Closing Background <code>[closing_bg_image]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[company_logo]')">Company Logo <code>[company_logo]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[custom_img:stamp]')">Stamp Badge <code>[custom_img:stamp]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[custom_img:seal]')">Corporate Seal <code>[custom_img:seal]</code></button>
            </div>
          </div>

          <!-- Category 6: Custom Labeled Brand Colors -->
          <div style="margin-top:16px;">
            <h4 style="margin:0 0 8px 0; font-size:12px; text-transform:uppercase; letter-spacing:0.05em; color:#f43f5e;"><i class="fa fa-paint-brush"></i> 🎨 Custom Brand Colors</h4>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
              <button class="var-chip" onclick="insertTokenIntoCanvas('[custom_color:accent]')">Accent Color <code>[custom_color:accent]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[custom_color:gold]')">Gold Highlight <code>[custom_color:gold]</code></button>
              <button class="var-chip" onclick="insertTokenIntoCanvas('[custom_color:footer_bg]')">Footer Dark <code>[custom_color:footer_bg]</code></button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- QUICK IN-EDITOR GLOBAL BRANDING MODAL -->
    <div id="quickBrandingModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.8); z-index:99999; backdrop-filter:blur(5px); align-items:center; justify-content:center;">
      <div style="background:#1e2433; border:1px solid rgba(255,255,255,0.15); border-radius:12px; width:600px; max-width:92vw; box-shadow:0 20px 40px rgba(0,0,0,0.6); color:#f1f5f9; overflow:hidden;">
        <div style="padding:16px 20px; background:#252d40; border-bottom:1px solid rgba(255,255,255,0.1); display:flex; justify-content:space-between; align-items:center;">
          <h3 style="margin:0; font-size:16px; font-weight:700; color:#fff; display:flex; align-items:center; gap:8px;">
            <i class="fa fa-paint-brush" style="color:#38bdf8;"></i> 🎨 Quick Global Domain Branding
          </h3>
          <button onclick="closeQuickGlobalBrandingModal()" style="background:none; border:none; color:#94a3b8; font-size:18px; cursor:pointer;"><i class="fa fa-times"></i></button>
        </div>
        <div style="padding:20px; max-height:75vh; overflow-y:auto;">
          
          <!-- 1-Click Theme Presets -->
          <div style="margin-bottom:20px;">
            <label style="font-size:12px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:8px;">⚡ Quick 1-Click Theme Presets</label>
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px;">
              <button onclick="applyModalPreset('#ff4c00', '#0a2540', '\'Inter\', sans-serif')" style="background:#0f172a; border:1px solid #334155; padding:8px; border-radius:6px; cursor:pointer; color:#fff; font-size:11px; text-align:center;">
                <div style="display:flex; justify-content:center; gap:4px; margin-bottom:4px;">
                  <span style="width:12px; height:12px; background:#ff4c00; border-radius:50%; display:inline-block;"></span>
                  <span style="width:12px; height:12px; background:#0a2540; border-radius:50%; display:inline-block;"></span>
                </div>
                EBMS Orange
              </button>
              <button onclick="applyModalPreset('#2563eb', '#1e293b', '\'Poppins\', sans-serif')" style="background:#0f172a; border:1px solid #334155; padding:8px; border-radius:6px; cursor:pointer; color:#fff; font-size:11px; text-align:center;">
                <div style="display:flex; justify-content:center; gap:4px; margin-bottom:4px;">
                  <span style="width:12px; height:12px; background:#2563eb; border-radius:50%; display:inline-block;"></span>
                  <span style="width:12px; height:12px; background:#1e293b; border-radius:50%; display:inline-block;"></span>
                </div>
                Corporate Blue
              </button>
              <button onclick="applyModalPreset('#059669', '#064e3b', '\'Montserrat\', sans-serif')" style="background:#0f172a; border:1px solid #334155; padding:8px; border-radius:6px; cursor:pointer; color:#fff; font-size:11px; text-align:center;">
                <div style="display:flex; justify-content:center; gap:4px; margin-bottom:4px;">
                  <span style="width:12px; height:12px; background:#059669; border-radius:50%; display:inline-block;"></span>
                  <span style="width:12px; height:12px; background:#064e3b; border-radius:50%; display:inline-block;"></span>
                </div>
                Emerald Green
              </button>
              <button onclick="applyModalPreset('#d97706', '#451a03', '\'Roboto\', sans-serif')" style="background:#0f172a; border:1px solid #334155; padding:8px; border-radius:6px; cursor:pointer; color:#fff; font-size:11px; text-align:center;">
                <div style="display:flex; justify-content:center; gap:4px; margin-bottom:4px;">
                  <span style="width:12px; height:12px; background:#d97706; border-radius:50%; display:inline-block;"></span>
                  <span style="width:12px; height:12px; background:#451a03; border-radius:50%; display:inline-block;"></span>
                </div>
                Luxury Gold
              </button>
            </div>
          </div>

          <!-- Domain Default Table Style -->
          <div style="margin-bottom:20px; border-top:1px solid rgba(255,255,255,0.1); padding-top:16px;">
            <label style="font-size:12px; font-weight:700; color:#cbd5e1; display:block; margin-bottom:4px;">🗂 Default Proposal Table Style (Domain)</label>
            <small style="color:#94a3b8; font-size:10px; display:block; margin-bottom:10px;">Applies to all proposals by default. Override per-template from the builder topbar &ldquo;Table Style&rdquo; dropdown.</small>
            <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:6px;">
              <button onclick="setDomainTableTheme('navy-corporate')" id="dtt-navy-corporate" style="background:#0a2540; border:2px solid transparent; padding:8px 4px; border-radius:6px; cursor:pointer; color:#fff; font-size:10px; text-align:center; transition:all .15s;">
                <div style="width:18px;height:18px;background:#c7d7e8;border:2px solid #fff;border-radius:50%;margin:0 auto 4px;"></div>Navy
              </button>
              <button onclick="setDomainTableTheme('emerald-clean')" id="dtt-emerald-clean" style="background:#047857; border:2px solid transparent; padding:8px 4px; border-radius:6px; cursor:pointer; color:#fff; font-size:10px; text-align:center; transition:all .15s;">
                <div style="width:18px;height:18px;background:#a7f3d0;border:2px solid #fff;border-radius:50%;margin:0 auto 4px;"></div>Emerald
              </button>
              <button onclick="setDomainTableTheme('gold-premium')" id="dtt-gold-premium" style="background:#92400e; border:2px solid transparent; padding:8px 4px; border-radius:6px; cursor:pointer; color:#fff; font-size:10px; text-align:center; transition:all .15s;">
                <div style="width:18px;height:18px;background:#fde68a;border:2px solid #fff;border-radius:50%;margin:0 auto 4px;"></div>Gold
              </button>
              <button onclick="setDomainTableTheme('minimal-lines')" id="dtt-minimal-lines" style="background:#334155; border:2px solid transparent; padding:8px 4px; border-radius:6px; cursor:pointer; color:#fff; font-size:10px; text-align:center; transition:all .15s;">
                <div style="width:18px;height:18px;background:#f1f5f9;border:2px solid #e2e8f0;border-radius:50%;margin:0 auto 4px;"></div>Minimal
              </button>
              <button onclick="setDomainTableTheme('rose-soft')" id="dtt-rose-soft" style="background:#9d174d; border:2px solid transparent; padding:8px 4px; border-radius:6px; cursor:pointer; color:#fff; font-size:10px; text-align:center; transition:all .15s;">
                <div style="width:18px;height:18px;background:#fbcfe8;border:2px solid #fff;border-radius:50%;margin:0 auto 4px;"></div>Rose
              </button>
            </div>
            <input type="hidden" id="selectedDomainTableTheme" value="navy-corporate">
          </div>

          <!-- Company Logo -->
          <div style="margin-bottom:16px;">
            <label style="font-size:12px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:6px;">Company Logo Image</label>
            <div style="display:flex; gap:8px;">
              <input type="url" id="modalLogoUrl" class="form-control" value="<%= (domain && domain.logo_url) || '' %>" placeholder="https://example.com/logo.png" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:8px 12px; border-radius:6px; font-size:13px;">
              <button type="button" onclick="openAssetPickerFor('modalLogoUrl')" class="tb-btn tb-btn-ghost" style="padding:6px 12px; font-size:12px; background:#2563eb; color:#fff; border:none;">
                <i class="fa fa-folder-open"></i> 📷 Choose Image
              </button>
            </div>
          </div>

          <!-- Primary & Secondary Color Pickers -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
              <label style="font-size:12px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:6px;">Primary Brand Color</label>
              <div style="display:flex; gap:8px; align-items:center;">
                <input type="color" id="modalPrimaryColor" value="<%= (domain && domain.brand_primary_color) || '#ff4c00' %>" style="width:44px; height:38px; padding:0; border:none; background:none; cursor:pointer;" oninput="document.getElementById('modalPrimaryHex').value=this.value;">
                <input type="text" id="modalPrimaryHex" value="<%= (domain && domain.brand_primary_color) || '#ff4c00' %>" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:8px 12px; border-radius:6px; font-size:13px;" oninput="document.getElementById('modalPrimaryColor').value=this.value;">
              </div>
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:6px;">Secondary Brand Color</label>
              <div style="display:flex; gap:8px; align-items:center;">
                <input type="color" id="modalSecondaryColor" value="<%= (domain && domain.brand_secondary_color) || '#0a2540' %>" style="width:44px; height:38px; padding:0; border:none; background:none; cursor:pointer;" oninput="document.getElementById('modalSecondaryHex').value=this.value;">
                <input type="text" id="modalSecondaryHex" value="<%= (domain && domain.brand_secondary_color) || '#0a2540' %>" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:8px 12px; border-radius:6px; font-size:13px;" oninput="document.getElementById('modalSecondaryColor').value=this.value;">
              </div>
            </div>
          </div>

          <!-- Background Images -->
          <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:16px; margin-top:16px;">
            <label style="font-size:12px; font-weight:700; color:#38bdf8; display:block; margin-bottom:10px;">🖼️ Master Page Background Images</label>
            
            <div style="margin-bottom:10px;">
              <label style="font-size:11px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:4px;">Cover Page Background Image</label>
              <div style="display:flex; gap:8px;">
                <input type="url" id="modalCoverBg" class="form-control" placeholder="https://example.com/cover-bg.jpg" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:6px 10px; border-radius:6px; font-size:12px;">
                <button type="button" onclick="openAssetPickerFor('modalCoverBg')" class="tb-btn tb-btn-ghost" style="padding:6px 12px; font-size:11px; background:#10b981; color:#fff; border:none;">
                  <i class="fa fa-folder-open"></i> 📷 Choose Image
                </button>
              </div>
            </div>

            <div style="margin-bottom:10px;">
              <label style="font-size:11px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:4px;">Inner Page Background Image</label>
              <div style="display:flex; gap:8px;">
                <input type="url" id="modalInnerBg" class="form-control" placeholder="https://example.com/inner-bg.jpg" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:6px 10px; border-radius:6px; font-size:12px;">
                <button type="button" onclick="openAssetPickerFor('modalInnerBg')" class="tb-btn tb-btn-ghost" style="padding:6px 12px; font-size:11px; background:#10b981; color:#fff; border:none;">
                  <i class="fa fa-folder-open"></i> 📷 Choose Image
                </button>
              </div>
            </div>

            <div style="margin-bottom:10px;">
              <label style="font-size:11px; font-weight:600; color:#cbd5e1; display:block; margin-bottom:4px;">Closing Page Background Image</label>
              <div style="display:flex; gap:8px;">
                <input type="url" id="modalClosingBg" class="form-control" placeholder="https://example.com/closing-bg.jpg" style="flex:1; background:#0f172a; border:1px solid #334155; color:#fff; padding:6px 10px; border-radius:6px; font-size:12px;">
                <button type="button" onclick="openAssetPickerFor('modalClosingBg')" class="tb-btn tb-btn-ghost" style="padding:6px 12px; font-size:11px; background:#10b981; color:#fff; border:none;">
                  <i class="fa fa-folder-open"></i> 📷 Choose Image
                </button>
              </div>
            </div>
          </div>

          <!-- Custom Labeled Images & Badges -->
          <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:16px; margin-top:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
