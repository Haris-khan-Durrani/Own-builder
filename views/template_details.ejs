editor.Commands.add('open-conditions', {
    run(editor) {
        const container = document.getElementById('conditions-panel');
        
        if (!container) {
            // Create the panel content dynamically
            const panelContainer = document.createElement('div');
            panelContainer.id = 'conditions-panel';
            panelContainer.innerHTML = `
                <h4>Manage Conditions</h4>
                <p>Add JavaScript conditions here to dynamically manage content, styles, or attributes.</p>
                <div id="selected-element-info">
                    <p><strong>Selected Element:</strong> <span id="element-info">None</span></p>
                </div>
                <textarea style="width: 100%; height: 200px;" id="condition-editor" placeholder="Write your JavaScript conditions here..."></textarea>
                <button id="apply-condition" style="margin-top: 10px;">Apply</button>
            `;
            document.querySelector('.gjs-pn-views-container').appendChild(panelContainer);

            // Add event listener for the apply button
            document.getElementById('apply-condition').addEventListener('click', () => {
                const condition = document.getElementById('condition-editor').value;
                if (condition) {
                    alert(`Condition Applied:\n${condition}`);
                    console.log('Condition:', condition);

                    // Get the selected component
                    const selectedComponent = editor.getSelected();
                    console.log('Selected Component:', selectedComponent);  // Debugging line

                    if (selectedComponent) {
                        try {
                            const elementId = selectedComponent.getId();
                            console.log('Selected Element ID:', elementId);  // Debugging line

                            if (elementId) {
                                // Apply the JavaScript condition to the selected component
                                if (condition.includes('textContent') || condition.includes('innerHTML')) {
                                    const content = condition.split('=')[1].trim().replace(/['";]/g, ''); // Extracting new content
                                    console.log('Setting content:', content);  // Debugging line

                                    // Set content using the selected component's model API
                                    selectedComponent.set('content', content); // Correctly set the content via GrapesJS API
                                    
                                    // Manually trigger re-render if needed
                                    selectedComponent.trigger('change:content');  // Trigger re-render of the component
                                    
                                    // Debugging to check if content is set correctly
                                    const updatedContent = selectedComponent.get('content');
                                    console.log('Updated content (after set):', updatedContent);  // Debugging line
                                }
                                // If it's a style modification
                                else if (condition.includes('style')) {
                                    const styleParts = condition.split(';');
                                    styleParts.forEach(style => {
                                        if (style.trim()) {
                                            const [property, value] = style.split(':').map(str => str.trim());
                                            selectedComponent.addStyle({ [property]: value });
                                        }
                                    });
                                }
                                // If it's an attribute modification
                                else if (condition.includes('setAttribute')) {
                                    const [attribute, value] = condition.match(/setAttribute\(['"](.*)['"],\s*['"](.*)['"]\)/).slice(1, 3);
                                    selectedComponent.setAttributes({ [attribute]: value });
                                }
                                // Handle other cases if needed
                                else {
                                    console.log('Unsupported condition format:', condition);
                                }
                            } else {
                                console.error('Element ID is missing.');
                            }
                        } catch (error) {
                            console.error('Error applying condition:', error);
                        }
                    } else {
                        alert('Please select an element first.');
                    }
                } else {
                    alert('Please write a condition before applying.');
                }
            });

            // Listen for element selection and update the selected element info
            editor.on('component:selected', (model) => {
                const elementInfo = document.getElementById('element-info');
                if (model) {
                    const elementId = model.getId() ? `ID: ${model.getId()}` : 'No ID';
                    const elementClass = model.getClasses().length > 0 ? `Class: ${model.getClasses().join(', ')}` : 'No Class';
                    elementInfo.innerHTML = `${elementId}, ${elementClass}`;
                } else {
                    elementInfo.innerHTML = 'None';
                }
            });
        }
    },
    stop(editor) {
        // Hide the panel when the tab is toggled off
        const container = document.getElementById('conditions-panel');
        if (container) {
            container.remove();
        }
    }
});

editor.on('asset:add', async (asset) => {
    const assetSrc = asset.get('src');
    
    // Check if the asset is an external URL (not a local file)
    if (assetSrc.startsWith('http')) {
        console.log('External URL added:', assetSrc);

        try {
            const domainId = '<%- domain_id %>'; // Use the actual domain ID

            // Send the URL to your server to store it in the media table
            const response = await fetch(`/upload-media/${domainId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ fileUrl: assetSrc }),
            });

            const data = await response.json();

            if (data.id) {
                console.log('Media saved in database with ID:', data.id);

                // Update the asset with the correct ID
                asset.set('id', data.id);
            } else {
                console.error('Failed to save media:', data.error);
            }
        } catch (error) {
            console.error('Error uploading external URL:', error);
        }
    }
});


// Listen for the asset upload response
editor.on('asset:upload:response', (response) => {
  console.log('Asset upload response:', response);

  const uploadedAssetUrl = response.url;
  const uploadedAssetId = response.id;

  // Hide the loading spinner once the response is received
  Swal.close();

  if (uploadedAssetUrl) {
    console.log('Uploaded asset URL:', uploadedAssetUrl);

    // Manually add the uploaded asset to the Asset Manager
    editor.AssetManager.add([{
      src: uploadedAssetUrl,
      type: 'image',
      id: uploadedAssetId,
    }]);

    // Optionally, you can trigger a refresh of the UI
    editor.AssetManager.render();

    // Show success message after successful upload
    Swal.fire({
      title: 'Success!',
      text: 'The asset has been uploaded successfully.',
      icon: 'success',
      confirmButtonText: 'OK'
    });
  } else {
    console.log('No URL in the upload response:', response);

    // Show error message if something went wrong
    Swal.fire({
      title: 'Error!',
      text: 'There was an issue with the asset upload.',
      icon: 'error',
      confirmButtonText: 'Try Again'
    });
  }
});
