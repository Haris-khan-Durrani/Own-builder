    <script>
    // Function to fetch and populate domain dropdown
    async function fetchDomains() {
        try {
            // Replace with your API endpoint or data-fetching method
            const response = await axios.get('/domains'); // Example endpoint
            const domains = response.data;
            
            console.log('Fetched domains:', domains); // Log the fetched data

            const dropdown = document.getElementById('domainDropdown');
            if (!dropdown) {
                console.error('Dropdown element not found!');
                return;
            }

            if (!Array.isArray(domains)) {
                console.error('Expected an array but received:', domains);
                return;
            }

            // Get the selected value from your template data
            const selectedDomainId = "<%= template.domain_id %>";

            domains.forEach(domain => {
                const option = document.createElement('option');
                option.value = domain.id;
                option.textContent = domain.domain;

                // Preselect the option if it matches the template value
                if (domain.id.toString() === selectedDomainId) {
                    option.selected = true;
                }

                dropdown.appendChild(option);
            });

            console.log('Dropdown populated successfully.');
        } catch (error) {
            console.error('Error fetching domains:', error);
        }
    }

    // Call the function when the page loads
    document.addEventListener('DOMContentLoaded', fetchDomains);
</script>

