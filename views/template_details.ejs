    function clickElementsInIframe(className) {
        const $iframe = $(`iframe.${className}`);
        if ($iframe.length) {
            $iframe.on('load', function () {
                setTimeout(() => {
                    const iframeDocument = this.contentDocument || this.contentWindow.document;

                    if (iframeDocument) {
                        const $elements = $(iframeDocument).find('*'); // Select all elements in the iframe
                        $elements.each(function () {
                            try {
                                $(this).click(); // Simulate a click
                                console.log("Clicked element:", this);
                            } catch (err) {
                                console.error("Error clicking element:", err);
                            }
                        });
                    } else {
                        console.error("Could not access the iframe's document.");
                    }
                }, 10000); // 10-second delay before clicking elements
            });
        } else {
            console.warn("Iframe not yet available, retrying...");
            setTimeout(() => clickElementsInIframe(className), 1000); // Retry after 1 second
        }
    }

