      if (token.startsWith('[custom_img:')) {
        const label = token.replace('[custom_img:', '').replace(']', '').trim();
        const payload = typeof getCustomImagesPayload === 'function' ? getCustomImagesPayload() : [];
        const match = payload.find(p => p.label === label);
        if (match && match.url) return match.url;
      }
      return null;
    }

    function insertTokenIntoCanvas(token) {
      if (!editor) return;
      const selected = editor.getSelected();
      const realImageUrl = resolveImageTokenUrl(token);

      if (realImageUrl) {
        if (selected) {
          if (selected.is('image') || selected.get('tagName') === 'img') {
            selected.setAttributes({ ...selected.getAttributes(), src: realImageUrl });
          } else {
            selected.addStyle({ 'background-image': `url('${realImageUrl}')`, 'background-size': 'cover', 'background-position': 'center' });
          }
        } else {
          editor.addComponents(`<img src="${realImageUrl}" alt="${token}" style="max-width:100%; height:auto;" />`);
        }
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: `Applied Master Image ${token}`,
          showConfirmButton: false,
          timer: 2000
        });
      } else if (selected && selected.is('text')) {
        const currentContent = selected.get('content') || '';
        selected.set('content', currentContent + ' ' + token);
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: `Inserted ${token}`,
          showConfirmButton: false,
          timer: 1500
        });
      } else {
        // Fallback: Copy to clipboard if no text component selected
        navigator.clipboard.writeText(token);
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'info',
          title: `Copied ${token} to clipboard!`,
          text: 'Select a text element or container on canvas to insert directly.',
          showConfirmButton: false,
          timer: 2500
        });
      }
      closeVariablePickerModal();
    }

