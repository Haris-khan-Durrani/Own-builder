      function saveTemplate() {
      
        // Simulate clicking all components in the editor
        const allComponents = editor.DomComponents.getComponents();
        const clickAllComponents = (components) => {
            components.forEach(component => {
                const view = component.getView();
                if (view && view.el && typeof view.el.click === 'function') {
                    console.log("in click")
                    view.el.click(); // Simulate a click on the component's DOM element
                }
                // Recursively click nested components
                if (component.get('components').length > 0) {
                    clickAllComponents(component.get('components'));
                }
            });
        };
        
        // Show saving state in topbar
        const dot = document.getElementById('save-dot');
        const label = document.getElementById('save-label');
        const btn = document.getElementById('save-btn');
        if (dot) { dot.classList.add('saving'); }
        if (label) label.textContent = 'Saving...';
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...'; }

        Swal.fire({
            title: 'Saving...',
            text: 'Please wait while we save your data.',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
    
        clickAllComponents(allComponents);
        setTimeout(() => {

      
      
          // const mjml = editor.getHtml(); // Get HTML content
          // let csos = editor.getCss();  // Get CSS content
          var mjml = editor.DomComponents.getWrapper().toHTML(); // Get the HTML content
          var csos = editor.CssComposer.getAll().map(rule => rule.toCSS()).join(''); // Get the CSS styles
          
          // // Replace each `{` with `{` followed by a newline
          // csos = csos.replace(/{/g, '{\n  ');
          // // Replace each `}` with `}` followed by a newline
          // csos = csos.replace(/}/g, '}\n');
          // // Replace each `;` with `;` followed by a newline
          // csos = csos.replace(/;/g, ';\n  ');
            
            
          // Now you can use the beautified and formatted `csos`
          console.log("CSS:", csos);  // Log the result

          const components = editor.getComponents();  // JSON representation (includes traits)
          console.log(components);
          // const jscript = JSON.stringify(components.map(component => component.get('script'))); // Extract scripts from components
          const titl = document.getElementById("titl").value; // Get title
          const tempid = "<%= template.template_id %>"; // Template ID
          
          // Get the selected domain_id
          const domainId = document.getElementById("domainDropdown").value; // Selected domain ID
          
          // Extract scripts from components
            const scripts = components
                .map(component => component.get('script')) // Get script from each component
                .filter(script => script !== ''); // Only include non-empty scripts
            
            // Convert the array of scripts into JSON format
            const json = JSON.stringify(scripts);
            
            // Debug: Log the extracted parts
            console.log("Extracted Scripts:", scripts);
            console.log("Scripts in JSON format:", json);
          
        const scriptRegex = /<script\b[^>]*>([\s\S]*?)<\/script>/gm;
        const styleRegex = /<style\b[^>]*>([\s\S]*?)<\/style>/gm;
        const scriptMatch = mjml.match(scriptRegex);
        const jscript = scriptMatch ? scriptMatch[0].trim() : ""; // Remove script tags
    
        // Remove script and style tags from HTML
        const cleanedHtml = mjml.replace(scriptRegex, "").replace(styleRegex, "").trim();
    
        // Debug: Log extracted parts
        console.log("Extracted HTML:", cleanedHtml);
        console.log("Extracted Script:", jscript);
        
          // Log payload size for debugging
          console.log("Payload size:", new Blob([mjml, csos, titl]).size, "bytes");
          const tableThemeVal = document.getElementById('tableThemeDropdown') ? document.getElementById('tableThemeDropdown').value : 'domain';
          
          fetch("/save", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ html: cleanedHtml, csos, titl, tempid, jscript, json, domainId, table_theme: tableThemeVal }),
          })
            .then((res) => res.text())
            .then((msg) => {
              // Restore topbar to saved state
              const dot = document.getElementById('save-dot');
              const label = document.getElementById('save-label');
              const btn = document.getElementById('save-btn');
              if (dot) { dot.classList.remove('saving'); }
              if (label) label.textContent = 'All changes saved';
              if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa fa-floppy-o"></i> Save Template'; }
              Swal.fire("Saved!", "Template saved successfully.", "success").then(() => {
                window.location.href = `https://builder.crmsoftware.ae/template/${tempid}?domain_id=${domainId}&token=${token}`;
