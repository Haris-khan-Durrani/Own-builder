    <script>
    // ═══════════════════════════════════════════════════════════════
    // SMART STYLE PANEL – JavaScript Engine
    // ═══════════════════════════════════════════════════════════════
    const SSP = {
      model: null,
      pinned: false,
      activeTab: 'typography',
      units: { fs:'px', w:'px', h:'px' },
      filters: { blur:'0px', brightness:'100%', contrast:'100%', saturate:'100%', 'hue-rotate':'0deg', grayscale:'0%' },

      // ── Open panel with a component model
      open(model) {
        this.model = model;
        document.getElementById('ssp-panel').classList.add('ssp-open');
        document.body.classList.add('ssp-open');
        this.populate(model);
      },

      // ── Close panel
      close() {
        if (this.pinned) return;
        document.getElementById('ssp-panel').classList.remove('ssp-open');
        document.body.classList.remove('ssp-open');
        this.model = null;
      },

      // ── Pin toggle
      togglePin() {
        this.pinned = !this.pinned;
        const btn = document.getElementById('ssp-pin-btn');
        if (btn) {
          btn.classList.toggle('active', this.pinned);
          btn.innerHTML = this.pinned ? '<i class="fa fa-thumb-tack"></i> Pinned' : '<i class="fa fa-thumb-tack"></i> Pin';
        }
      },

      // ── Switch tab
      switchTab(tab) {
        this.activeTab = tab;
        document.querySelectorAll('.ssp-tab').forEach((el,i) => {
          const tabs = ['typography','spacing','background','border','effects','position','flexbox','content'];
          el.classList.toggle('ssp-tab-active', tabs[i] === tab);
        });
        document.querySelectorAll('.ssp-pane').forEach(el => el.classList.remove('ssp-pane-active'));
        const pane = document.getElementById('ssp-pane-' + tab);
        if (pane) pane.classList.add('ssp-pane-active');
      },

      // ── Apply a single style property
      apply(prop, val) {
        if (!this.model) return;
        if (val === '' || val === null || val === undefined) return;
        this.model.addStyle({ [prop]: val });
        this.updatePreview();
      },

      // ── Apply background-image with url() wrapping
      applyBgImage(val) {
        if (!val) return;
        const v = val.trim().startsWith('url(') ? val.trim() : `url('${val.trim()}')`;
        this.apply('background-image', v);
      },

      // ── Apply CSS filter (accumulates multiple filter functions)
      applyFilter(fn, val) {
        this.filters[fn] = val;
        const filterStr = Object.entries(this.filters)
          .filter(([k,v]) => {
            if (k === 'blur' && v === '0px') return false;
            if (k === 'brightness' && v === '100%') return false;
            if (k === 'contrast' && v === '100%') return false;
            if (k === 'saturate' && v === '100%') return false;
            if (k === 'hue-rotate' && v === '0deg') return false;
            if (k === 'grayscale' && v === '0%') return false;
            return true;
          })
          .map(([k,v]) => `${k}(${v})`).join(' ');
        this.apply('filter', filterStr || 'none');
      },

      // ── Apply content to a text component
      applyContent(val) {
        if (!this.model) return;
        this.model.components().reset([]);
        this.model.set('content', val);
      },

      // ── Apply HTML attribute
      applyAttr(attr, val) {
        if (!this.model) return;
        this.model.setAttributes({ [attr]: val });
      },

      // ── Toggle a button group (only one active per group)
      toggleBgBtn(el, prop, val) {
        const parent = el.parentNode;
        parent.querySelectorAll('.ssp-bgbtn').forEach(b => b.classList.remove('active'));
        el.classList.add('active');
        this.apply(prop, val);
      },

      // ── Unit management
      setUnit(key, unit, btn) {
        this.units[key] = unit;
        const parent = btn.parentNode;
        parent.querySelectorAll('.ssp-unit-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      },
      getUnit(key) { return this.units[key] || 'px'; },

      // ── Populate all controls from the current model styles
      populate(model) {
        const s = model.getStyle();
        const get = (p, def='') => s[p] || def;

        // Breadcrumb
        const tagBadge = document.getElementById('ssp-tag-badge');
        const clsBadge = document.getElementById('ssp-cls-badge');
        if (tagBadge) tagBadge.textContent = model.get('tagName') || model.get('type') || 'div';
        if (clsBadge) {
          const classes = model.getClasses();
          clsBadge.textContent = classes.length ? '.' + classes.slice(0,2).join(' .') : '';
          clsBadge.style.display = classes.length ? '' : 'none';
        }

        // Typography
        SSP._setVal('ssp-font-family', get('font-family'));
        const fs = parseFloat(get('font-size','14')) || 14;
        SSP._setVal('ssp-font-size-range', fs);
        SSP._setVal('ssp-font-size-num', fs);
        SSP._setVal('ssp-lh-range', get('line-height','1.4'));
        SSP._setVal('ssp-lh-num', get('line-height','1.4'));
        const lsRaw = parseFloat(get('letter-spacing','0')) || 0;
        SSP._setVal('ssp-ls-range', lsRaw);
        SSP._setVal('ssp-ls-num', lsRaw);
        const wsRaw = parseFloat(get('word-spacing','0')) || 0;
        SSP._setVal('ssp-ws-range', wsRaw);
        SSP._setVal('ssp-ws-num', wsRaw);
        SSP._setVal('ssp-whitespace', get('white-space'));
        const clr = get('color','#000000');
        SSP._setColor('ssp-color', 'ssp-color-hex', clr);

        // Spacing
        SSP._setVal('ssp-width', get('width'));
        SSP._setVal('ssp-height', get('height'));
        SSP._setVal('ssp-min-width', get('min-width'));
        SSP._setVal('ssp-max-width', get('max-width'));
        SSP._setVal('ssp-pt', get('padding-top'));
        SSP._setVal('ssp-pr', get('padding-right'));
        SSP._setVal('ssp-pb', get('padding-bottom'));
        SSP._setVal('ssp-pl', get('padding-left'));
        SSP._setVal('ssp-mt', get('margin-top'));
        SSP._setVal('ssp-mr', get('margin-right'));
        SSP._setVal('ssp-mb', get('margin-bottom'));
        SSP._setVal('ssp-ml', get('margin-left'));

        // Background
        const bgClr = get('background-color','');
        SSP._setColor('ssp-bg-color', 'ssp-bg-color-hex', bgClr);
        SSP._setVal('ssp-bg-gradient', get('background'));
        const bgImg = get('background-image','').replace(/url\(['"']?(.*?)['"']?\)/,'$1');
        SSP._setVal('ssp-bg-image', bgImg);
        SSP._setVal('ssp-bg-repeat', get('background-repeat','no-repeat'));
        SSP._setVal('ssp-bg-position', get('background-position','center center'));

        // Border
        const bw = parseFloat(get('border-width','0')) || 0;
        SSP._setVal('ssp-bw-range', bw);
        SSP._setVal('ssp-bw-num', bw);
        const bcl = get('border-color','#000000');
        SSP._setColor('ssp-border-color', 'ssp-border-color-hex', bcl);
        SSP._setVal('ssp-br-tl', get('border-top-left-radius'));
        SSP._setVal('ssp-br-tr', get('border-top-right-radius'));
        SSP._setVal('ssp-br-bl', get('border-bottom-left-radius'));
        SSP._setVal('ssp-br-br', get('border-bottom-right-radius'));
        SSP._setVal('ssp-border-radius-all', get('border-radius'));
        SSP._setVal('ssp-outline', get('outline'));

        // Effects
        const op = parseFloat(get('opacity','1'));
        SSP._setVal('ssp-opacity-range', op);
        SSP._setVal('ssp-opacity-num', op);
        SSP._setVal('ssp-box-shadow', get('box-shadow'));
        SSP._setVal('ssp-text-shadow', get('text-shadow'));
        SSP._setVal('ssp-transform', get('transform'));
        SSP._setVal('ssp-transition', get('transition'));
        SSP._setVal('ssp-mix-blend', get('mix-blend-mode'));

        // Position
        SSP._setVal('ssp-zindex', get('z-index'));
        SSP._setVal('ssp-top', get('top'));
        SSP._setVal('ssp-right', get('right'));
        SSP._setVal('ssp-bottom', get('bottom'));
        SSP._setVal('ssp-left', get('left'));
        SSP._setVal('ssp-cursor', get('cursor','default'));

        // Flex
        SSP._setVal('ssp-gap', get('gap'));
        SSP._setVal('ssp-flex', get('flex'));
        SSP._setVal('ssp-align-self', get('align-self'));
        SSP._setVal('ssp-grid-cols', get('grid-template-columns'));
        SSP._setVal('ssp-grid-rows', get('grid-template-rows'));

        // Content
        const contentEl = document.getElementById('ssp-content-area');
        if (contentEl) contentEl.value = model.get('content') || '';
        SSP._setVal('ssp-el-id', model.getId());
        SSP._setVal('ssp-el-class', model.getClasses().join(' '));

        this.updatePreview();
      },

      // ── Update live CSS preview
      updatePreview() {
        if (!this.model) return;
        const s = this.model.getStyle();
        const css = Object.entries(s).filter(([k,v]) => v).map(([k,v]) => `  ${k}: ${v};`).join('\n');
        const preview = document.getElementById('ssp-css-preview');
        if (preview) preview.value = css ? `{\n${css}\n}` : '';
      },

      // ── Copy CSS to clipboard
      copyCSS() {
        const preview = document.getElementById('ssp-css-preview');
        if (!preview || !preview.value) return;
        navigator.clipboard.writeText(preview.value).then(() => {
          Swal.fire({ toast:true, position:'top-end', icon:'success', title:'CSS Copied!', showConfirmButton:false, timer:1500 });
        });
      },

      // ── Reset all styles
      resetStyles() {
        if (!this.model) return;
        Swal.fire({
          title: 'Reset Styles?',
          text: 'This will remove all inline styles from this element.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc2626',
          confirmButtonText: 'Yes, Reset'
        }).then(r => {
          if (r.isConfirmed) {
            this.model.setStyle({});
            this.populate(this.model);
            Swal.fire({ toast:true, position:'top-end', icon:'success', title:'Styles reset!', showConfirmButton:false, timer:1500 });
          }
        });
      },

      // ── Helpers
      _setVal(id, val) {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null) el.value = val;
      },
      _setColor(colorId, hexId, val) {
        if (!val) return;
        const hexMatch = val.match(/#[0-9a-fA-F]{3,6}/);
        const hexVal = hexMatch ? hexMatch[0] : '#000000';
        const colorEl = document.getElementById(colorId);
        const hexEl = document.getElementById(hexId);
        if (colorEl) try { colorEl.value = hexVal; } catch(e) {}
        if (hexEl) hexEl.value = val;
      }
    };

    // ── Wire up GrapesJS events (runs after editor is initialized)
    setTimeout(() => {
      if (typeof editor !== 'undefined') {
        editor.on('component:selected', model => SSP.open(model));
        editor.on('component:deselected', () => { if (!SSP.pinned) SSP.close(); });
      }
    }, 800);
    </script>

  </body>
</html>