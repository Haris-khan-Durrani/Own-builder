    const enablecondition = enableconditionTrait.get("value");
    console.log("enablecondition", enablecondition);
    const conditiontype = model.getTrait('conditiontype')?.getValue();

    console.log('Updating trait visibility:', { enablecondition, conditiontype });

    // Show/hide traits based on 'enablecondition'
    ['effect', 'conditiontype', 'conditionvalue', 'comparison'].forEach((traitName) => {
      const trait = model.getTrait(traitName);
      if (trait) {
            // Define shouldHide variable outside the if-else block
        let shouldHide;
        console.log("enablecondition",enablecondition);
    
        // Determine if the trait should be hidden based on enablecondition
        if (enablecondition === false || enablecondition == 'false' || enablecondition == false) {
            console.log("shouldHide set to true");
          shouldHide = true;  // Set shouldHide to true if enablecondition is 'false'
        } else {
        console.log("shouldHide set to false");
          shouldHide = false; // Set shouldHide to false if enablecondition is not 'false'
        }
        
        console.log(`Trait: ${traitName}, Hidden: ${shouldHide}`);
        trait.set('hidden', shouldHide); // Update the hidden state
        console.log("traittt",JSON.stringify({ trait: trait }));
        if (trait.view && trait.view.el) {
          trait.view.el.style.display = shouldHide ? 'none' : 'block';
        }
      }
    });

    // Show 'Query Key' only if 'conditiontype' is 'query'
    const querykeyTrait = model.getTrait('querykey');
    if (querykeyTrait) {
      const shouldHide = conditiontype !== 'query' || enablecondition == 'false';
      console.log(`Trait: querykey, Hidden: ${shouldHide}`);
      querykeyTrait.set('hidden', shouldHide);
      if (querykeyTrait.view && querykeyTrait.view.el) {
        querykeyTrait.view.el.style.display = shouldHide ? 'none' : 'block';
      }
    }

    // Show 'Form Value' only if 'conditiontype' is 'value'
    const formValueTrait = model.getTrait('formValue');
    if (formValueTrait) {
      const shouldHide = conditiontype !== 'value' || enablecondition == 'false';
      console.log(`Trait: formValue, Hidden: ${shouldHide}`);
      formValueTrait.set('hidden', shouldHide);
      if (formValueTrait.view && formValueTrait.view.el) {
        formValueTrait.view.el.style.display = shouldHide ? 'none' : 'block';
      }
    }

    // Show 'HTML Text' only if 'conditiontype' is 'htmltext'
    const htmltextTrait = model.getTrait('htmltext');
    if (htmltextTrait) {
      const shouldHide = conditiontype !== 'html' || enablecondition == 'false';
      console.log(`Trait: htmltext, Hidden: ${shouldHide}`);
      htmltextTrait.set('hidden', shouldHide);
      if (htmltextTrait.view && htmltextTrait.view.el) {
        htmltextTrait.view.el.style.display = shouldHide ? 'none' : 'block';
      }
    }
  };

  // Initialize visibility on component selection
  updateTraitVisibility();

  // Listen to 'enablecondition' changes
  const enableconditionCheckbox = model.getTrait('enablecondition');
  if (enableconditionCheckbox) {
    enableconditionCheckbox.on('change', updateTraitVisibility);
  }

  // Listen to 'conditiontype' changes
  const conditiontypeSelect = model.getTrait('conditiontype');
  if (conditiontypeSelect) {
    conditiontypeSelect.on('change', updateTraitVisibility);
  }

  // Automatically apply the script to the component
  model.set('script', function () {
    const item = items[i];
    // Fetch the current trait values dynamically
    const enablecondition = items[i].getAttribute('enablecondition');
    const type = items[i].getAttribute('conditiontype');
    const querykey = items[i].getAttribute('querykey');
    const conditionvalue = items[i].getAttribute('conditionvalue');
    const comparison = items[i].getAttribute('comparison');
    const effect = items[i].getAttribute('effect');
    const htmltext = items[i].getAttribute('htmltext');

    console.log('Script applied:', { enablecondition, type, querykey, conditionvalue, comparison, effect });
    
    // if (!enablecondition) {
    //   item.setAttribute('enablecondition', 'true');
    //   console.log('enablecondition set to true because it was empty or not defined');
    // }

    const updatedEnableCondition = item.getAttribute('enablecondition');

    console.log('Script applied:', { updatedEnableCondition, type, querykey, conditionvalue, comparison, effect });
    
    
    if (!updatedEnableCondition) return;

    let shouldShow = false;

    if (type === 'query') {
      const urlParams = new URLSearchParams(window.location.search);
      const paramValue = urlParams.get(querykey);
      shouldShow = evaluateCondition(paramValue, comparison, conditionvalue);
    } else if (type === 'html') {
          const itemId = items[i].id; // Get the ID
            if (!itemId) {
            console.warn('Item at index does not have an ID.');
            return; // Skip processing this item
            }
            
            const value =  '#'+itemId; // Build the selector dynamically based on ID
            console.log("Selector value:", value);
        
          const element = document.querySelector(value);
          console.log("element",element)
          const text = element ? element.textContent.trim() : '';
          console.log("text",text)
        
          if (effect === 'replace' && htmltext) {
            const normalizedText = text.replace(/\s+/g, ' ').trim(); // Normalize whitespace
            const normalizedhtmltext = htmltext.replace(/\s+/g, ' ').trim(); // Normalize input text
        
            if (element && normalizedText.includes(normalizedhtmltext)) {
              // Replace only the matching normalizedhtmltext part
              const regex = new RegExp(htmltext, 'g'); // Create a regex for replacement
              element.textContent = element.textContent.replace(regex, conditionvalue);
            } else {
              console.warn("htmltext not found in element's textContent.");
            }
          }
    } 

    if (effect === 'hide' && !shouldShow) {
      this.style.display = 'none';
    } else if (effect === 'show' && shouldShow) {
      this.style.display = '';
    }

    function evaluateCondition(input, comparison, value) {
      switch (comparison) {
        case "eq": if (input != value) 
                    {
                        console.log("in eq");
                        return true; 
                    }
                    break;
        case "neq": if (input == value) 
                    {
                        console.log("in neq");
                        return true; 
                    }
                    break;
        case 'lt': if (input >= value) 
                    {
                        console.log("in lt");
                        return true; 
                    }
                    break;
        case 'lte': if (input > value) 
                    {
                        console.log("in lte");
                        return true; 
                    }
                    break;
        case 'gt': if (input <= value) 
                    {
                        console.log("in gt");
                        return true; 
                    }
                    break;
        case 'gte': if (input < value) 
                    {
                        console.log("in gte");
                        return true; 
                    }
                    break;
        default: return false;
      }
    }
  });
}, 300);
});




    
