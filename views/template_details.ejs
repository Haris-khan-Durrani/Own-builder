    // ── Canvas Zoom & A4 Page Size Engine ──
    let currentZoom = 100;
    let currentOrientation = 'portrait';
    let currentMode = 'a4';

    function updateZoomDisplay() {
      const zv = document.getElementById('zoom-value');
      if (zv) zv.textContent = Math.round(currentZoom) + '%';
      if (typeof editor !== 'undefined' && editor.Canvas) {
        editor.Canvas.setZoom(currentZoom);
      }
    }

    function changeZoom(delta) {
      currentZoom = Math.min(200, Math.max(30, currentZoom + delta));
      updateZoomDisplay();
    }

    function resetZoom() {
      currentZoom = 100;
      updateZoomDisplay();
    }

    function fitZoom() {
      const canvasWrap = document.getElementById('editor-canvas-wrap');
      if (!canvasWrap) return;
      const availWidth = canvasWrap.clientWidth - 80;
      const targetWidth = currentMode === 'full' ? 1200 : (currentOrientation === 'portrait' ? 794 : 1123);
      let calcZoom = Math.floor((availWidth / targetWidth) * 100);
      currentZoom = Math.min(100, Math.max(40, calcZoom));
      updateZoomDisplay();
    }

    function setCanvasMode(mode) {
      currentMode = mode;
      const pBtn = document.getElementById('btn-mode-a4');
      const fBtn = document.getElementById('btn-mode-full');
      if (pBtn && fBtn) {
        if (mode === 'a4') {
          pBtn.classList.add('active-orient');
          fBtn.classList.remove('active-orient');
          applyCanvasDimensions(currentOrientation === 'portrait' ? '794px' : '1123px', currentOrientation === 'portrait' ? '1123px' : '794px');
        } else {
          fBtn.classList.add('active-orient');
          pBtn.classList.remove('active-orient');
          applyCanvasDimensions('100%', '100%');
        }
      }
    }

    function setOrientation(mode) {
      currentOrientation = mode;
      const pBtn = document.getElementById('btn-orient-portrait');
      const lBtn = document.getElementById('btn-orient-landscape');
      if (pBtn && lBtn) {
        if (mode === 'portrait') {
          pBtn.classList.add('active-orient');
          lBtn.classList.remove('active-orient');
        } else {
          lBtn.classList.add('active-orient');
          pBtn.classList.remove('active-orient');
        }
      }
      if (currentMode === 'a4') {
        const width = mode === 'portrait' ? '794px' : '1123px';
        const height = mode === 'portrait' ? '1123px' : '794px';
        applyCanvasDimensions(width, height);
      }
    }

    function applyCanvasDimensions(width, minHeight) {
      const wrapper = document.querySelector('.gjs-frame-wrapper');
      const frame = document.querySelector('.gjs-frame');
      if (wrapper) {
        wrapper.style.setProperty('width', width, 'important');
        wrapper.style.setProperty('min-height', minHeight, 'important');
      }
      if (frame) {
        frame.style.setProperty('width', width === '100%' ? '100%' : width, 'important');
      }
      if (typeof editor !== 'undefined' && editor.Canvas) {
        const canvasDoc = editor.Canvas.getDocument();
        if (canvasDoc && canvasDoc.body) {
          canvasDoc.body.style.setProperty('width', width, 'important');
          canvasDoc.body.style.setProperty('max-width', width, 'important');
          canvasDoc.body.style.setProperty('min-height', minHeight, 'important');
        }
      }
    }

    // ── A4 Canvas: inject page layout CSS into the canvas iframe ──
    editor.on('load', () => {
      // Set initial zoom and ensure standard A4 portrait sizing on load
      applyCanvasDimensions('794px', '1123px');
      resetZoom();

      // Inject A4 page-break and body styling into the canvas iframe
      const canvasDoc = editor.Canvas.getDocument();
      if (canvasDoc) {
        const a4Style = canvasDoc.createElement('style');
        a4Style.id = 'gjs-a4-canvas-style';
        a4Style.innerHTML = `
          /* Canvas body — exact A4 sheet centered */
          html, body {
            width: 794px !important;
            max-width: 794px !important;
            min-height: 1123px !important;   /* A4 height at 96dpi (297mm) */
            padding: 0 !important;
            margin: 0 auto !important;
            background: #ffffff !important;
            box-sizing: border-box !important;
            overflow-x: hidden !important;
          }

          /* Page break elements — show as visible separator */
          pagebreak {
            display: block !important;
            width: 100% !important;
            height: 44px !important;
            background: #0f172a !important;
            position: relative !important;
            margin: 24px 0 !important;
            box-sizing: border-box !important;
            border-top: 2px dashed rgba(56,189,248,.5) !important;
            border-bottom: 2px dashed rgba(56,189,248,.5) !important;
          }
          pagebreak::after {
            content: '— A4 Page Break —';
            display: block;
            text-align: center;
            line-height: 40px;
            color: rgba(56,189,248,.9);
            font-size: 11px;
            font-family: Inter, system-ui, sans-serif;
            font-weight: 600;
            letter-spacing: .08em;
            pointer-events: none;
          }

          /* Each new page block after a pagebreak has a subtle top shadow */
          pagebreak + table,
          pagebreak + div,
          pagebreak + section {
            box-shadow: 0 -4px 20px rgba(0,0,0,.08) !important;
          }

          /* Override GrapesJS inside-canvas selection highlight tools */
          .gjs-comp-selected {
            outline: 1.5px solid #38bdf8 !important;
          }
          .gjs-badge {
            background-color: #0f172a !important;
            color: #38bdf8 !important;
            border: 1px solid rgba(56,189,248,0.3) !important;
          }
        `;
        if (!canvasDoc.getElementById('gjs-a4-canvas-style')) {
          canvasDoc.head.appendChild(a4Style);
        }
      }
    });

