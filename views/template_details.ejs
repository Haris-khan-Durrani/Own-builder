    // Visual Asset Manager Picker Integration
    let activeAssetTargetInputId = null;
    let activeAssetIsAppend = false;

    function openAssetPickerFor(inputId, isAppend = false) {
      activeAssetTargetInputId = inputId;
      activeAssetIsAppend = isAppend;
      
      const brandingModal = document.getElementById('quickBrandingModal');
      if (brandingModal) {
        brandingModal.style.display = 'none';
      }

      if (typeof editor !== 'undefined' && editor.AssetManager) {
        // Collect current master global images and add to AssetManager
        const currentLogo = document.getElementById('modalLogoUrl') ? document.getElementById('modalLogoUrl').value : '';
        const currentCover = document.getElementById('modalCoverBg') ? document.getElementById('modalCoverBg').value : '';
        const currentInner = document.getElementById('modalInnerBg') ? document.getElementById('modalInnerBg').value : '';
        const currentClosing = document.getElementById('modalClosingBg') ? document.getElementById('modalClosingBg').value : '';

        const globalAssets = [
          { src: currentLogo, name: '🌐 Company Logo' },
          { src: currentCover, name: '🌐 Cover Page Background' },
          { src: currentInner, name: '🌐 Inner Page Background' },
          { src: currentClosing, name: '🌐 Closing Page Background' }
        ].filter(a => a.src && a.src.length > 5 && !a.src.startsWith('['));

        globalAssets.forEach(a => {
          try { editor.AssetManager.add({ src: a.src, name: a.name }); } catch(e){}
        });

        const restoreBrandingModal = () => {
          if (brandingModal) brandingModal.style.display = 'flex';
          editor.off('modal:close', restoreBrandingModal);
        };
        editor.on('modal:close', restoreBrandingModal);

        editor.AssetManager.open({
          select(asset, complete) {
            const src = typeof asset === 'string' ? asset : (asset.get ? asset.get('src') : asset.src);
            const targetEl = document.getElementById(activeAssetTargetInputId);
            if (targetEl) {
              if (activeAssetIsAppend && targetEl.value) {
                targetEl.value += ', ' + src;
              } else {
                targetEl.value = src;
              }
            }
            if (brandingModal) {
              brandingModal.style.display = 'flex';
            }
            if (complete) editor.AssetManager.close();
          }
        });
      }
    }

    function addCustomImageRow(label = '', url = '') {
      const container = document.getElementById('modalCustomImagesList');
      if (!container) return;
      const rowId = 'custom_row_' + Date.now() + '_' + Math.floor(Math.random()*1000);
      const row = document.createElement('div');
      row.id = rowId;
      row.style.display = 'grid';
      row.style.gridTemplateColumns = '120px 1fr 110px 32px';
      row.style.gap = '6px';
      row.style.alignItems = 'center';
      row.style.background = '#0f172a';
      row.style.padding = '6px 8px';
      row.style.borderRadius = '6px';

      row.innerHTML = `
        <input type="text" class="form-control custom-img-label" value="${label}" placeholder="Label (e.g. stamp)" style="background:#1e293b; border:1px solid #334155; color:#38bdf8; font-weight:600; font-size:11px; padding:4px 6px;">
        <input type="url" class="form-control custom-img-url" id="input_${rowId}" value="${url}" placeholder="Image URL (https://...)" style="background:#1e293b; border:1px solid #334155; color:#fff; font-size:11px; padding:4px 6px;">
        <button type="button" onclick="openAssetPickerFor('input_${rowId}')" style="background:#10b981; color:#fff; border:none; border-radius:4px; font-size:10px; padding:4px 6px; cursor:pointer;">
          <i class="fa fa-folder-open"></i> Pick Image
        </button>
        <button type="button" onclick="document.getElementById('${rowId}').remove()" style="background:#ef4444; color:#fff; border:none; border-radius:4px; font-size:10px; padding:4px 6px; cursor:pointer;" title="Delete">
          <i class="fa fa-trash"></i>
        </button>
      `;
      container.appendChild(row);
    }

    function getCustomImagesPayload() {
      const rows = document.querySelectorAll('#modalCustomImagesList > div');
      const list = [];
      rows.forEach(r => {
        const labelEl = r.querySelector('.custom-img-label');
        const urlEl = r.querySelector('.custom-img-url');
        if (labelEl && urlEl && urlEl.value.trim()) {
          const label = labelEl.value.trim() || 'addon';
          list.push({ label: label, url: urlEl.value.trim() });
        }
      });
      return list;
    }

    function addCustomColorRow(label = '', hex = '#3b82f6') {
      const container = document.getElementById('modalCustomColorsList');
      if (!container) return;
      const rowId = 'custom_color_row_' + Date.now() + '_' + Math.floor(Math.random()*1000);
      const row = document.createElement('div');
      row.id = rowId;
      row.style.display = 'grid';
      row.style.gridTemplateColumns = '130px 40px 100px 1fr 32px';
      row.style.gap = '6px';
      row.style.alignItems = 'center';
      row.style.background = '#0f172a';
      row.style.padding = '6px 8px';
      row.style.borderRadius = '6px';

      row.innerHTML = `
        <input type="text" class="form-control custom-color-label" value="${label}" placeholder="Label (e.g. accent)" style="background:#1e293b; border:1px solid #334155; color:#f43f5e; font-weight:600; font-size:11px; padding:4px 6px;">
        <input type="color" class="form-control custom-color-picker" value="${hex}" onchange="this.nextElementSibling.value = this.value" style="width:100%; height:28px; border:none; padding:0; background:none; cursor:pointer;">
        <input type="text" class="form-control custom-color-hex" value="${hex}" onchange="this.previousElementSibling.value = this.value" style="background:#1e293b; border:1px solid #334155; color:#fff; font-size:11px; padding:4px 6px;">
        <span style="font-size:10px; color:#94a3b8; font-family:monospace;">[custom_color:${label || 'label'}]</span>
        <button type="button" onclick="document.getElementById('${rowId}').remove()" style="background:#ef4444; color:#fff; border:none; border-radius:4px; font-size:10px; padding:4px 6px; cursor:pointer;" title="Delete">
          <i class="fa fa-trash"></i>
        </button>
      `;
      container.appendChild(row);
    }

    function getCustomColorsPayload() {
      const rows = document.querySelectorAll('#modalCustomColorsList > div');
      const list = [];
      rows.forEach(r => {
        const labelEl = r.querySelector('.custom-color-label');
        const hexEl = r.querySelector('.custom-color-hex');
        if (labelEl && hexEl) {
          const l = labelEl.value.trim();
          const h = hexEl.value.trim();
          if (l && h) list.push({ label: l, hex: h });
        }
      });
      return list;
    }

    // Quick In-Editor Global Branding Modal Functions
    async function openQuickGlobalBrandingModal() {
      const modal = document.getElementById('quickBrandingModal');
      if (modal) modal.style.display = 'flex';

      const domainId = "<%= domain_id %>" || "2";
      try {
        const res = await fetch(`/api/global-branding-settings/${domainId}`);
        if (res.ok) {
          const s = await res.json();
          if (s.company_logo && document.getElementById('modalLogoUrl')) document.getElementById('modalLogoUrl').value = s.company_logo;
          if (s.primary_color) {
            document.getElementById('modalPrimaryColor').value = s.primary_color;
            document.getElementById('modalPrimaryHex').value = s.primary_color;
          }
          if (s.secondary_color) {
            document.getElementById('modalSecondaryColor').value = s.secondary_color;
            document.getElementById('modalSecondaryHex').value = s.secondary_color;
          }
          if (s.font_family && document.getElementById('modalFontFamily')) document.getElementById('modalFontFamily').value = s.font_family;
          if (s.cover_bg_image && document.getElementById('modalCoverBg')) document.getElementById('modalCoverBg').value = s.cover_bg_image;
          if (s.inner_bg_image && document.getElementById('modalInnerBg')) document.getElementById('modalInnerBg').value = s.inner_bg_image;
          if (s.closing_bg_image && document.getElementById('modalClosingBg')) document.getElementById('modalClosingBg').value = s.closing_bg_image;
          
          const container = document.getElementById('modalCustomImagesList');
          if (container) container.innerHTML = '';

          if (s.addon_images) {
            try {
              const arr = typeof s.addon_images === 'string' ? JSON.parse(s.addon_images) : s.addon_images;
              if (Array.isArray(arr) && arr.length > 0) {
                arr.forEach(item => {
                  if (typeof item === 'object' && item !== null) {
                    addCustomImageRow(item.label || '', item.url || '');
                  } else if (typeof item === 'string') {
                    addCustomImageRow('badge', item);
                  }
                });
              } else {
                addCustomImageRow('stamp', '');
              }
            } catch(e) {
              addCustomImageRow('stamp', '');
            }
          } else {
            addCustomImageRow('stamp', '');
          }

          const colorsContainer = document.getElementById('modalCustomColorsList');
          if (colorsContainer) colorsContainer.innerHTML = '';
          if (s.custom_colors) {
            try {
              const colorArr = typeof s.custom_colors === 'string' ? JSON.parse(s.custom_colors) : s.custom_colors;
              if (Array.isArray(colorArr) && colorArr.length > 0) {
                colorArr.forEach(item => {
                  if (item && item.label && item.hex) addCustomColorRow(item.label, item.hex);
                });
              } else {
                addCustomColorRow('accent', '#f59e0b');
              }
            } catch(e) {
              addCustomColorRow('accent', '#f59e0b');
            }
          } else {
            addCustomColorRow('accent', '#f59e0b');
          }

          if (s.bank_title && document.getElementById('modalBankTile')) document.getElementById('modalBankTile').value = s.bank_title;
          if (s.account_number && document.getElementById('modalAccountNumber')) document.getElementById('modalAccountNumber').value = s.account_number;
          if (s.iban_number && document.getElementById('modalIbanNumber')) document.getElementById('modalIbanNumber').value = s.iban_number;
          if (s.bank_name && document.getElementById('modalBankName')) document.getElementById('modalBankName').value = s.bank_name;
          if (s.default_table_theme && document.getElementById('selectedDomainTableTheme')) {
            setDomainTableTheme(s.default_table_theme);
          }
        }
      } catch (err) {
        console.error('Error fetching global_branding_settings:', err);
      }
    }

    function closeQuickGlobalBrandingModal() {
      const modal = document.getElementById('quickBrandingModal');
      if (modal) modal.style.display = 'none';
    }

    function applyModalPreset(primary, secondary, font) {
      document.getElementById('modalPrimaryColor').value = primary;
      document.getElementById('modalPrimaryHex').value = primary;
      document.getElementById('modalSecondaryColor').value = secondary;
      document.getElementById('modalSecondaryHex').value = secondary;
      document.getElementById('modalFontFamily').value = font;
    }

    async function saveQuickGlobalBranding() {
      try {
        const domainId = "<%= domain_id %>" || "2";
        const logoUrl = document.getElementById('modalLogoUrl') ? document.getElementById('modalLogoUrl').value : '';
        const primaryColor = document.getElementById('modalPrimaryHex') ? document.getElementById('modalPrimaryHex').value : '#ff4c00';
        const secondaryColor = document.getElementById('modalSecondaryHex') ? document.getElementById('modalSecondaryHex').value : '#0a2540';
        const fontFamily = document.getElementById('modalFontFamily') ? document.getElementById('modalFontFamily').value : 'Arial, sans-serif';

        const coverBg = document.getElementById('modalCoverBg') ? document.getElementById('modalCoverBg').value : '';
        const innerBg = document.getElementById('modalInnerBg') ? document.getElementById('modalInnerBg').value : '';
        const closingBg = document.getElementById('modalClosingBg') ? document.getElementById('modalClosingBg').value : '';
        const addonImages = typeof getCustomImagesPayload === 'function' ? getCustomImagesPayload() : [];
        const customColors = typeof getCustomColorsPayload === 'function' ? getCustomColorsPayload() : [];

        const bankTile = document.getElementById('modalBankTile') ? document.getElementById('modalBankTile').value : '';
        const accountNumber = document.getElementById('modalAccountNumber') ? document.getElementById('modalAccountNumber').value : '';
        const ibanNumber = document.getElementById('modalIbanNumber') ? document.getElementById('modalIbanNumber').value : '';
        const bankName = document.getElementById('modalBankName') ? document.getElementById('modalBankName').value : '';
        const defaultTableTheme = document.getElementById('selectedDomainTableTheme') ? document.getElementById('selectedDomainTableTheme').value : 'navy-corporate';

        Swal.fire({
          title: 'Auto-saving Global Settings...',
          text: 'Saving background images, custom colors, bank details & assets to database...',
          allowOutsideClick: false,
          didOpen: () => Swal.showLoading()
        });

        const response = await fetch('/api/global-branding-settings/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            domain_id: domainId,
            company_logo: logoUrl,
            cover_bg_image: coverBg,
            inner_bg_image: innerBg,
            closing_bg_image: closingBg,
            addon_images: addonImages,
            custom_colors: customColors,
            primary_color: primaryColor,
            secondary_color: secondaryColor,
            font_family: fontFamily,
            bank_title: bankTile,
            account_number: accountNumber,
            iban_number: ibanNumber,
            bank_name: bankName,
            default_table_theme: defaultTableTheme
          })
        });

        const result = await response.json();
        if (result.success) {
          closeQuickGlobalBrandingModal();
          
          // Live update CSS variable tokens on current GrapesJS canvas
          if (typeof editor !== 'undefined') {
            const iframe = editor.Canvas.getFrameEl();
            if (iframe && iframe.contentDocument) {
              const root = iframe.contentDocument.documentElement;
              root.style.setProperty('--brand-primary', primaryColor);
              root.style.setProperty('--brand-secondary', secondaryColor);
              root.style.setProperty('--brand-font', fontFamily);
              if (coverBg) root.style.setProperty('--cover-bg', `url('${coverBg}')`);
              if (innerBg) root.style.setProperty('--inner-bg', `url('${innerBg}')`);
              if (closingBg) root.style.setProperty('--closing-bg', `url('${closingBg}')`);
            }
          }

          Swal.fire('Saved!', 'Global domain branding updated and applied live!', 'success');
        } else {
          Swal.fire('Error', result.error || 'Failed to save branding', 'error');
        }
      } catch (err) {
        console.error("Save branding error:", err);
        Swal.fire('Error', err.message || 'Failed to save branding', 'error');
      }
    }

    function convertToModernDesign() {
      Swal.fire({
        title: '✨ Upgrade Page 2 to Modern 360 Design?',
        text: 'Page 1 (Cover Page) and all other pages (Documents, Bank Info, Terms) will be 100% PRESERVED! Only Page 2 (Package & Price Overview) will be upgraded to the Image 2 layout.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#0284c7',
        cancelButtonColor: '#475569',
        confirmButtonText: 'Yes, Upgrade Page 2!'
      }).then((result) => {
        if (result.isConfirmed) {
          const currentHtml = editor.getHtml();
          const pagebreakRegex = /(<pagebreak[^>]*>[\s\S]*?<\/pagebreak>)/gi;
          const parts = currentHtml.split(pagebreakRegex);

          const tplTitle = document.getElementById('titl') ? document.getElementById('titl').value : 'Unlimited Visa Quota';
          const newPage2HTML = MODERN_PROPOSAL_LAYOUT_HTML.replace('[package_title]', tplTitle);

          if (parts.length >= 3) {
            // Part 0 = Page 1 (Cover Page - ALWAYS PRESERVED!)
            // Part 1 = First <pagebreak> (PRESERVED!)
            // Part 2 = Page 2 (Replaced with Image 2 Modern Design)
            // Parts 3+ = Pages 3, 4, 5, etc. (ALWAYS PRESERVED!)
            parts[2] = newPage2HTML;
            const finalHtml = parts.join('');
            editor.setComponents(finalHtml);
          } else {
            // Single page template
            editor.setComponents(newPage2HTML);
          }

          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'Page 2 Upgraded to Modern 360 Layout!',
            text: 'Cover Page & all other pages are preserved intact. Click "Save Template" to keep changes.',
            showConfirmButton: false,
            timer: 5000
          });
        }
      });
    }

    // Automatically load dynamic blocks when GrapesJS is ready
    if (typeof editor !== 'undefined') {
      editor.on('load', () => {
        loadDynamicBlocks();
      });
    }

    </script>

