              <div style="display: flex; gap: 4px;">
                <button class="vi-btn" style="padding: 2px 6px; font-size: 10px; background: rgba(255,255,255,0.1); color: #ffffff;" onclick="VI.expandAssociatedCodeModal()" title="Expand Fullscreen Side-by-Side View"><i class="fa-solid fa-expand"></i> Expand View</button>
