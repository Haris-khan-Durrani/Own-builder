      applyBrandThemeToTemplate() {
        const primary = document.getElementById('swal-brand-primary-hex').value.trim();
        const secondary = document.getElementById('swal-brand-secondary-hex').value.trim();
        const font = document.getElementById('swal-brand-font').value.trim();

        saveHistoryState();
        if (cssAce) {
          let css = cssAce.getValue();
          const brandCssRule = `:root {\n  --brand-primary: ${primary};\n  --brand-secondary: ${secondary};\n  --brand-font: '${font}';\n}\n\n`;
          if (css.includes(':root {')) {
            css = css.replace(/:root\s*\{[^}]*\}/, `:root {\n  --brand-primary: ${primary};\n  --brand-secondary: ${secondary};\n  --brand-font: '${font}';\n}`);
          } else {
            css = brandCssRule + css;
          }
          cssAce.setValue(css, -1);
        }

        this.syncIframeToCode();
        renderPreview();
        if (window.Swal) {
          Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '🎨 Global Brand Theme Applied!', showConfirmButton: false, timer: 1500 });
        }
      },

      saveGlobalBranding() {
        const primary = document.getElementById('swal-brand-primary-hex').value.trim();
        const secondary = document.getElementById('swal-brand-secondary-hex').value.trim();
        const font = document.getElementById('swal-brand-font').value.trim();
        const logo = document.getElementById('swal-brand-logo').value.trim();

        fetch('/api/global-branding-settings/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            domain_id: DOMAIN_ID,
            primary_color: primary,
            secondary_color: secondary,
            font_family: font,
            company_logo: logo
          })
        })
        .then(r => r.json())
        .then(data => {
          window.globalBranding = { primary_color: primary, secondary_color: secondary, font_family: font, company_logo: logo };
          if (window.Swal) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '💾 Global Branding Saved!', showConfirmButton: false, timer: 1500 });
          }
        })
        .catch(err => {
          if (window.Swal) Swal.fire({ icon: 'error', title: 'Save Failed', text: err.message });
        });
      },

      syncIframeToCode() {
        const iframe = document.getElementById('preview-iframe');
        if (!iframe || !htmlAce) return;
        const doc = iframe.contentDocument || iframe.contentWindow.document;
        if (!doc) return;

        const tempDiv = doc.createElement('div');
        tempDiv.innerHTML = doc.body.innerHTML;
        tempDiv.querySelectorAll('[data-vi-hover]').forEach(el => el.removeAttribute('data-vi-hover'));
        tempDiv.querySelectorAll('[data-vi-selected]').forEach(el => el.removeAttribute('data-vi-selected'));
        tempDiv.querySelectorAll('[data-vi-dragover]').forEach(el => el.removeAttribute('data-vi-dragover'));
        tempDiv.querySelectorAll('[draggable]').forEach(el => el.removeAttribute('draggable'));
        tempDiv.querySelectorAll('.vi-floating-bar').forEach(el => el.remove());
        tempDiv.querySelectorAll('script[data-preview-script]').forEach(el => el.remove());

        let cleanHtml = tempDiv.innerHTML.replace(/^[\s\r\n]+/, '').replace(/[\s\r\n]+$/, '');
        
        isSyncingFromVI = true;
        htmlAce.setValue(cleanHtml, -1);
        isSyncingFromVI = false;

        markAsDirty();
      },

      _setVal(id, val) {
        const el = document.getElementById(id);
        if (el && val !== undefined && val !== null) el.value = val;
      },

      _rgbToHex(rgb) {
        if (!rgb || rgb === 'transparent' || rgb.indexOf('rgba(0, 0, 0, 0)') !== -1) return '#ffffff';
        if (rgb.startsWith('#')) return rgb;
        const matches = rgb.match(/\d+/g);
        if (!matches || matches.length < 3) return '#ffffff';
        return '#' + matches.slice(0, 3).map(x => parseInt(x).toString(16).padStart(2, '0')).join('');
      }
    };

    function closeVisualInspector() {
      document.getElementById('visual-inspector-panel').classList.remove('open');
      const iframe = document.getElementById('preview-iframe');
      if (iframe) {
        try {
          const doc = iframe.contentDocument || iframe.contentWindow.document;
          doc.querySelectorAll('[data-vi-selected]').forEach(el => el.removeAttribute('data-vi-selected'));
          doc.querySelectorAll('.vi-floating-bar').forEach(el => el.remove());
        } catch(e) {}
      }
    }

    function ensurePDFPrintColorAdjust() {
      if (!cssAce) return;
      let css = cssAce.getValue();
      const printRule = `@media print {\n  * {\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n    color-adjust: exact !important;\n  }\n}\n\n`;
      if (!css.includes('print-color-adjust')) {
        css = printRule + css;
        cssAce.setValue(css, -1);
        if (window.Swal) {
          Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '📄 PDF Print Color Adjust Rule Added!', showConfirmButton: false, timer: 1800 });
        }
      }
    }

    function openPDFPrintPreview() {
      ensurePDFPrintColorAdjust();
      const htmlContent = htmlAce ? htmlAce.getValue().trim() : '';
      const cssContent = cssAce ? cssAce.getValue().trim() : '';
      const jsContent = jsAce ? jsAce.getValue().trim() : '';

      const win = window.open('', '_blank');
      if (win) {
        win.document.write(`<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>PDF Print View - ${TEMPLATE_ID}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }
    }
    ${cssContent}
  </style>
</head>
<body onload="setTimeout(() => window.print(), 300)">
  ${htmlContent}
  <script>${jsContent}<\/script>
</body>
</html>`);
        win.document.close();
      }
    }

    function openPreviewTab() {
      const htmlContent = htmlAce ? htmlAce.getValue() : "";
      const cssContent = cssAce ? cssAce.getValue() : "";
      const jsContent = jsAce ? jsAce.getValue() : "";

      const win = window.open();
      if (win) {
        win.document.write(`<!DOCTYPE html>
<html>
<head>
  <title>Preview - ${TEMPLATE_ID}</title>
  <style>${cssContent}</style>
</head>
<body>
  ${htmlContent}
  <script>${jsContent}<\/script>
</body>
</html>`);
        win.document.close();
      }
    }

    function saveTemplate() {
      if (!htmlAce || !cssAce || !jsAce) return;
      ensurePDFPrintColorAdjust();

      const saveBtn = document.getElementById('save-btn');
      const originalText = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Saving...`;

      const payload = {
        templateId: TEMPLATE_ID,
        html: htmlAce.getValue().trim(),
        css: cssAce.getValue().trim(),
        custom_js: jsAce.getValue().trim(),
        domainId: DOMAIN_ID
      };

      fetch('/save-template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        if (data.error) {
          Swal.fire({ title: 'Save Failed', text: data.error, icon: 'error', confirmButtonColor: '#ef4444' });
        } else {
          markAsClean();
          Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Template saved successfully!', showConfirmButton: false, timer: 2000 });
        }
      })
      .catch(err => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        console.error("Save error:", err);
        Swal.fire({ title: 'Network Error', text: 'Failed to communicate with server.', icon: 'error', confirmButtonColor: '#ef4444' });
      });
    }
  </script>
</body>
</html>
