  <!-- STUNNING FULLSCREEN COMPONENT CODE & CSS INSPECTOR MODAL -->
  <div id="expanded-code-modal" class="custom-modal-overlay">
    <div class="custom-modal-container">
      <!-- Modal Header -->
      <div class="custom-modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
